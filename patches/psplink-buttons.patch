+ *
+ * pad.h - Inject controller button presses from the PSPLINK shell
+ */
+#ifndef __PAD_H__
+#define __PAD_H__
+
+/* Implements the "btn" shell command; returns CMD_OK or CMD_ERROR */
+int padCommand(int argc, char **argv);
+
+#endif
