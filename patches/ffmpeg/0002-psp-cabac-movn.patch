--- a/libavcodec/cabac_functions.h
+++ b/libavcodec/cabac_functions.h
@@ -113,18 +113,44 @@
 #endif
 
 #ifndef get_cabac_inline
+#if defined(__PSP__) && PSP_CABAC_MOVN
+/* The probability state is separate from the arithmetic coder context. Keep
+ * range/low in registers across its byte store instead of alias-driven spills. */
+static av_always_inline int get_cabac_inline(CABACContext *restrict c, uint8_t *restrict const state){
+#else
 static av_always_inline int get_cabac_inline(CABACContext *c, uint8_t * const state){
+#endif
     int s = *state;
     int RangeLPS= ff_h264_lps_range[2*(c->range&0xC0) + s];
     int bit, lps_mask;
 
     c->range -= RangeLPS;
+#if defined(__PSP__) && PSP_CABAC_MOVN
+    /* Allegrex conditional moves preserve the scalar interval decision while
+     * avoiding two mask/merge dependency chains. Refill and renormalization
+     * below remain unchanged. Early clobbers protect all live input values. */
+    int split = c->range << (CABAC_BITS + 1);
+    int low = c->low, range = c->range, alternate;
+    __asm__ (
+        "subu %[mask], %[split], %[low]\n\t"
+        "sra  %[mask], %[mask], 31\n\t"
+        "subu %[alternate], %[low], %[split]\n\t"
+        "movn %[low], %[alternate], %[mask]\n\t"
+        "movn %[range], %[lps], %[mask]\n\t"
+        "xor  %[state], %[state], %[mask]"
+        : [mask] "=&r" (lps_mask), [alternate] "=&r" (alternate),
+          [low] "+&r" (low), [range] "+&r" (range), [state] "+r" (s)
+        : [split] "r" (split), [lps] "r" (RangeLPS));
+    c->low = low;
+    c->range = range;
+#else
     lps_mask= ((c->range<<(CABAC_BITS+1)) - c->low)>>31;
 
     c->low -= (c->range<<(CABAC_BITS+1)) & lps_mask;
     c->range += (RangeLPS - c->range) & lps_mask;
 
     s^=lps_mask;
+#endif
     *state= (ff_h264_mlps_state+128)[s];
     bit= s&1;
 
