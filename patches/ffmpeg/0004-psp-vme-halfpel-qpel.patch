+#ifndef AVCODEC_H264_VME_QPEL_H
+#define AVCODEC_H264_VME_QPEL_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "libavutil/buffer.h"
+
+typedef struct PspVmeHalfpelPlanes {
+    const uint8_t *p20;
+    const uint8_t *p02;
+    const uint8_t *p22;
+    int stride;
+    int width;
+    int height;
+} PspVmeHalfpelPlanes;
+
+extern AVBufferRef *(*avpriv_psp_vme_ref_build)(const uint8_t *luma, int stride,
+                                                int width, int height,
+                                                PspVmeHalfpelPlanes *out);
+
+static inline uint32_t psp_vme_ulw(const uint8_t *p)
+{
+#if defined(__mips__)
+    uint32_t v;
+    __asm__ volatile("ulw %0, 0(%1)" : "=r"(v) : "r"(p) : "memory");
+    return v;
+#else
+    uint32_t v;
+    memcpy(&v, p, 4);
+    return v;
+#endif
+}
+
+static inline uint32_t psp_vme_avg4(uint32_t a, uint32_t b)
+{
+    return (a | b) - (((a ^ b) & 0xfefefefeu) >> 1);
+}
+
+static inline void psp_vme_copy_block(uint8_t *dst, ptrdiff_t dst_stride,
+                                      const uint8_t *src, ptrdiff_t src_stride,
+                                      int size, int is_avg)
+{
+    if (!is_avg) {
+        for (int r = 0; r < size; ++r) {
+            for (int c = 0; c < size; c += 4) {
+                uint32_t v = psp_vme_ulw(src + c);
+                *(uint32_t *)(dst + c) = v;
+            }
+            src += src_stride;
+            dst += dst_stride;
+        }
+    } else {
+        for (int r = 0; r < size; ++r) {
+            for (int c = 0; c < size; c += 4) {
+                uint32_t v = psp_vme_ulw(src + c);
+                uint32_t old = *(uint32_t *)(dst + c);
+                *(uint32_t *)(dst + c) = psp_vme_avg4(old, v);
+            }
+            src += src_stride;
+            dst += dst_stride;
+        }
+    }
+}
+
+static inline void psp_vme_avg2_block(uint8_t *dst, ptrdiff_t dst_stride,
+                                      const uint8_t *src_a, ptrdiff_t stride_a,
+                                      const uint8_t *src_b, ptrdiff_t stride_b,
+                                      int size, int is_avg)
+{
+    if (!is_avg) {
+        for (int r = 0; r < size; ++r) {
+            for (int c = 0; c < size; c += 4) {
+                uint32_t a = psp_vme_ulw(src_a + c);
+                uint32_t b = psp_vme_ulw(src_b + c);
+                *(uint32_t *)(dst + c) = psp_vme_avg4(a, b);
+            }
+            src_a += stride_a;
+            src_b += stride_b;
+            dst += dst_stride;
+        }
+    } else {
+        for (int r = 0; r < size; ++r) {
+            for (int c = 0; c < size; c += 4) {
+                uint32_t a = psp_vme_ulw(src_a + c);
+                uint32_t b = psp_vme_ulw(src_b + c);
+                uint32_t p = psp_vme_avg4(a, b);
+                uint32_t old = *(uint32_t *)(dst + c);
+                *(uint32_t *)(dst + c) = psp_vme_avg4(old, p);
+            }
+            src_a += stride_a;
+            src_b += stride_b;
+            dst += dst_stride;
+        }
+    }
+}
+
+/* Exact ISO/IEC 14496-10 luma quarter-pel MC using precomputed P20/P02/P22 planes. */
+static inline void psp_vme_qpel_mc(uint8_t *dst, const uint8_t *src_p00, ptrdiff_t p00_stride,
+                                   const PspVmeHalfpelPlanes *hp,
+                                   int full_mx, int full_my, int luma_xy,
+                                   int size, int is_avg)
+{
+    const ptrdiff_t hs = hp->stride;
+    const ptrdiff_t off = (ptrdiff_t)full_my * hs + full_mx;
+    const uint8_t *p20 = hp->p20 + off;
+    const uint8_t *p02 = hp->p02 + off;
+    const uint8_t *p22 = hp->p22 + off;
+
+    switch (luma_xy) {
+    case 2:  psp_vme_copy_block(dst, p00_stride, p20, hs, size, is_avg); break;
+    case 8:  psp_vme_copy_block(dst, p00_stride, p02, hs, size, is_avg); break;
+    case 10: psp_vme_copy_block(dst, p00_stride, p22, hs, size, is_avg); break;
+    case 1:  psp_vme_avg2_block(dst, p00_stride, src_p00, p00_stride, p20, hs, size, is_avg); break;
+    case 3:  psp_vme_avg2_block(dst, p00_stride, src_p00 + 1, p00_stride, p20, hs, size, is_avg); break;
+    case 4:  psp_vme_avg2_block(dst, p00_stride, src_p00, p00_stride, p02, hs, size, is_avg); break;
+    case 12: psp_vme_avg2_block(dst, p00_stride, src_p00 + p00_stride, p00_stride, p02, hs, size, is_avg); break;
+    case 5:  psp_vme_avg2_block(dst, p00_stride, p20, hs, p02, hs, size, is_avg); break;
+    case 7:  psp_vme_avg2_block(dst, p00_stride, p20, hs, p02 + 1, hs, size, is_avg); break;
+    case 13: psp_vme_avg2_block(dst, p00_stride, p20 + hs, hs, p02, hs, size, is_avg); break;
+    case 15: psp_vme_avg2_block(dst, p00_stride, p20 + hs, hs, p02 + 1, hs, size, is_avg); break;
+    case 6:  psp_vme_avg2_block(dst, p00_stride, p20, hs, p22, hs, size, is_avg); break;
+    case 14: psp_vme_avg2_block(dst, p00_stride, p20 + hs, hs, p22, hs, size, is_avg); break;
+    case 9:  psp_vme_avg2_block(dst, p00_stride, p02, hs, p22, hs, size, is_avg); break;
+    case 11: psp_vme_avg2_block(dst, p00_stride, p02 + 1, hs, p22, hs, size, is_avg); break;
+    default: break;
+    }
+}
+
+#endif /* AVCODEC_H264_VME_QPEL_H */
