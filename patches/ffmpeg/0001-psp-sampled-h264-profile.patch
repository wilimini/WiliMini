diff --git a/libavcodec/psp_profile.h b/libavcodec/psp_profile.h
new file mode 100644
--- /dev/null
+++ b/libavcodec/psp_profile.h
@@ -0,0 +1,25 @@
+/* Single-thread PSP lab profiling hooks; times are sampled, not totals. */
+#ifndef PSP_LAB_PROFILE_H
+#define PSP_LAB_PROFILE_H
+#include <stdint.h>
+#define PSP_PROFILE_QPEL_BASE 20
+#define PSP_PROFILE_CHROMA_BASE 148
+#define PSP_PROFILE_STAGES 180
+#define PSP_PROFILE_INTERVAL 31
+typedef struct {
+    uint64_t us;
+    unsigned calls, samples;
+} PspProfileStage;
+extern int psp_profile_enabled;
+extern PspProfileStage psp_profile_stages[PSP_PROFILE_STAGES];
+unsigned psp_profile_tick(void);
+#define PSP_PROFILE(stage, ...) do { \
+    if (!psp_profile_enabled) { __VA_ARGS__; } else { \
+        PspProfileStage *psp_prof_counter = &psp_profile_stages[stage]; \
+        int psp_prof_sample = (psp_prof_counter->calls++ % PSP_PROFILE_INTERVAL) == 0; \
+        unsigned psp_prof_begin = psp_prof_sample ? psp_profile_tick() : 0; \
+        __VA_ARGS__; \
+        if (psp_prof_sample) { psp_prof_counter->us += (unsigned)(psp_profile_tick() - psp_prof_begin); ++psp_prof_counter->samples; } \
+    } \
+} while (0)
+#endif
diff --git a/libavcodec/psp_chroma_fast.h b/libavcodec/psp_chroma_fast.h
new file mode 100644
--- /dev/null
+++ b/libavcodec/psp_chroma_fast.h
@@ -0,0 +1,41 @@
+#ifndef AVCODEC_PSP_CHROMA_FAST_H
+#define AVCODEC_PSP_CHROMA_FAST_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+static inline uint32_t psp_avg_bytes(uint32_t dst, uint32_t src)
+{
+    return (dst | src) - (((dst ^ src) & 0xfefefefeU) >> 1);
+}
+
+static inline void psp_chroma_put8_copy(uint8_t *dst, const uint8_t *src,
+                                        ptrdiff_t stride, int height)
+{
+    for (int row = 0; row < height; ++row) {
+        memcpy(dst, src, 8);
+        dst += stride;
+        src += stride;
+    }
+}
+
+static inline void psp_chroma_avg8_copy(uint8_t *dst, const uint8_t *src,
+                                        ptrdiff_t stride, int height)
+{
+    for (int row = 0; row < height; ++row) {
+        uint32_t d0, d1, s0, s1;
+        memcpy(&d0, dst, 4);
+        memcpy(&d1, dst + 4, 4);
+        memcpy(&s0, src, 4);
+        memcpy(&s1, src + 4, 4);
+        d0 = psp_avg_bytes(d0, s0);
+        d1 = psp_avg_bytes(d1, s1);
+        memcpy(dst, &d0, 4);
+        memcpy(dst + 4, &d1, 4);
+        dst += stride;
+        src += stride;
+    }
+}
+
+#endif
