+/* Resolve the actual selected kernel only when profiling is enabled. */
+static inline int psp_qpel_stage(const H264Context *h, const qpel_mc_func *op, int xy)
+{
+    for (int size = 0; size < 4; ++size) {
+        if (op == h->h264qpel.put_h264_qpel_pixels_tab[size])
+            return PSP_PROFILE_QPEL_BASE + size * 32 + xy;
+        if (op == h->h264qpel.avg_h264_qpel_pixels_tab[size])
+            return PSP_PROFILE_QPEL_BASE + size * 32 + 16 + xy;
+    }
+    return 18;
+}
+
+static inline int psp_chroma_stage(const H264Context *h, h264_chroma_mc_func op,
+                                   int x, int y)
+{
+    int phase = !!x + 2 * !!y;
+    for (int size = 0; size < 4; ++size) {
+        if (op == h->h264chroma.put_h264_chroma_pixels_tab[size])
+            return PSP_PROFILE_CHROMA_BASE + size * 8 + phase;
+        if (op == h->h264chroma.avg_h264_chroma_pixels_tab[size])
+            return PSP_PROFILE_CHROMA_BASE + size * 8 + 4 + phase;
+    }
+    return 19;
+}
